{
  "manifest_version": 3,
  "name": "DigitalClerk - Smart Form Filler",
  "version": "1.0.0",
  "description": "Fill Indian government forms in 15 seconds with AI-powered data extraction",
  
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "webNavigation"
  ],
  
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "https://localhost:*/*",
      "https://*.lovable.app/*",
      "https://*.digitalclerk.app/*"
    ]
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "DigitalClerk - Smart Form Filler",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  
  "background": {
    "service_worker": "service-worker.js"
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "icon16.png",
        "icon32.png",
        "icon48.png",
        "icon128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  
  "author": "DigitalClerk Team",
  "homepage_url": "https://digitalclerk.app"
}
