# Backend API URL
VITE_API_BASE_URL=http://localhost:5000/api

# Razorpay Configuration
# Get your keys from: https://dashboard.razorpay.com/app/website-app-settings/api-keys
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here

# Google Cloud Vision API Key
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# App Information
VITE_APP_NAME=DigitalClerk
VITE_APP_URL=http://localhost:5173

# Production URLs (uncomment when deploying)
# VITE_API_BASE_URL=https://your-backend-domain.com/api
# VITE_APP_URL=https://digitalclerk.app
